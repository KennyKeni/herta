# App
NODE_ENV=test
PORT=3000
CORS_ORIGIN=*
SWAGGER_ENABLED=false

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=herta
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
BETTER_AUTH_SECRET=test-secret-that-is-at-least-32-characters-long
AUTH_SESSION_EXPIRES_IN=604800
AUTH_SESSION_UPDATE_AGE=86400
AUTH_JWT_EXPIRES_IN=1h

# Email
RESEND_API_KEY=re_test_dummy
EMAIL_FROM=test@test.com

# S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=test
S3_PUBLIC_URL=http://localhost:9000/test

# Upload
UPLOAD_WORKER_URL=http://localhost:8787
UPLOAD_JWT_SECRET=test-secret-that-is-at-least-32-characters-long
UPLOAD_JWT_EXPIRES_IN=3600

# Cache
CACHE_ENABLED=false
CACHE_MAX_AGE=60
CACHE_STALE_WHILE_REVALIDATE=300
